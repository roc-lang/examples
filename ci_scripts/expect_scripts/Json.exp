#!/usr/bin/expect

# uncomment line below for debugging
# exp_internal 1

set timeout 7

source ./ci_scripts/expect_scripts/shared-code.exp

spawn ./examples/Json/main


expect "Successfully decoded image, title:\"View from 15th Floor\"\r\n" {
    expect eof {
        spawn ./examples/Json/main {{"image":{"animated":true,"height":1,"ids":[],"thumbnail":{"height":1,"url":"u","width":1},"title":"Sunset","width":1}}}

        expect "Successfully decoded image, title:\"Sunset\"\r\n" {
            expect eof {
                check_exit_and_segfault
            }
        }

        puts stderr "\nError: output was different from expected value."
        exit 1
    }
}

puts stderr "\nError: output was different from expected value."
exit 1