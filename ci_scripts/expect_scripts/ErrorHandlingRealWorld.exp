#!/usr/bin/expect

# uncomment line below for debugging
# exp_internal 1

# Generous timeout: this example does a real HTTP request
set timeout 30

source ./ci_scripts/expect_scripts/shared-code.exp

set env(HELLO) 1

spawn ./examples/ErrorHandlingRealWorld/main "https://www.roc-lang.org" roc.html

expect {
    "Done\r\n" {
        expect eof {
            check_exit_and_segfault
        }
    }
    timeout {
        puts stderr "\nError: timed out after $timeout seconds waiting for \"Done\"."
        exit 1
    }
    eof {
        puts stderr "\nError: program exited before printing \"Done\". wait status: [wait]"
        exit 1
    }
}

puts stderr "\nError: output was different from expected value."
exit 1
