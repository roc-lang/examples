#!/usr/bin/expect

# uncomment line below for debugging
# exp_internal 1

set timeout 7

source ./ci_scripts/expect_scripts/shared-code.exp

if {[on_windows]} {
    # The pseudo console of MSYS2 does not pass on Ctrl-Z, which ends console input on Windows, so pipe the numbers in.
    spawn sh -c {printf '1\n2\n-1\n' | ./examples/LoopEffect/main}
} else {
    spawn ./examples/LoopEffect/main
}

expect "Enter some numbers on different lines, then press Ctrl-D to sum them up.\r\n"

if {![on_windows]} {
    send -- "1\r"
    send -- "2\r"
    send -- "-1\r"

    # send Ctrl+D
    send "\004"
}

expect "Sum: 2\r\n" {
  expect eof {
    spawn ./examples/LoopEffect/main

    expect "Enter some numbers on different lines, then press Ctrl-D to sum them up.\r\n"

    send -- "1\r"
    send -- "a\r"

    expect "Error: \"a\" is not a valid I64 number.\r\n" {
      expect eof {
          check_exit_and_segfault 1
      }
    }

    puts stderr "\nError: output was different than expected."
    exit 1
  }
  
  puts stderr "\nError: output was different than expected."
  exit 1
}

puts stderr "\nError: output was different than expected."
exit 1