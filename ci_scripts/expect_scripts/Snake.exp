#!/usr/bin/expect

# uncomment line below for debugging
# exp_internal 1

set timeout 7

source ./ci_scripts/expect_scripts/shared-code.exp

# On Windows, Tty.enable_raw_mode! only affects the console of the game, so put the terminal of expect in raw mode as well.
if {[on_windows]} {
    set stty_init "raw -echo"
}

spawn ./examples/Snake/main

expect "Score: 0\r\n" {

    # Press 's' key 9 times
    for {set i 1} {$i <= 9} {incr i} {
        send "s"
        
        expect -re {Score:.*}
    }

    # This press should make the snake collide with the bottom wall and lead to game over
    send "s"

    expect -re {.*Game Over.*} {
        expect eof {
            check_exit_and_segfault
        }
    }
    
}

puts stderr "\nExpect script failed: output was different from expected value. uncomment `exp_internal 1` to debug."
exit 1