#!/usr/bin/expect

# uncomment line below for debugging
# exp_internal 1

set timeout 7

source ./ci_scripts/expect_scripts/shared-code.exp

spawn ./examples/Commands/main

set expected_output [normalize_output {
Hello
"Hi
"
BAZ=DUCK
FOO=BAR
XYZ=ABC
}]

# On Windows, env and cat come from MSYS2, whose env adds TERM and HOME to the cleared environment.
if {[on_windows]} {
    append expected_output "TERM=xterm-256color\r\nHOME=$env(HOME)\r\n"
}

append expected_output [normalize_output {
cat: non_existent.txt: No such file or directory
Exit status: Exited\(1\)
\[72, 105, 10\]
}]

expect $expected_output {
    expect eof {
        check_exit_and_segfault
    }
}
puts stderr "\nError: output was different from expected value."
exit 1